# ─────────────────────────────────────────────────────────────
# GreenCrowd V2 — Environment Variables
# Copy to .env.local for development or .env for production.
# NEVER commit .env to the repository.
# ─────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
DOMAIN=localhost

# ── Database (PostgreSQL 16 + PostGIS) ───────────────────────
DATABASE_URL="postgresql://greencrowd:greencrowd_secret@localhost:5432/greencrowd?schema=public"
POSTGRES_USER=greencrowd
POSTGRES_PASSWORD=greencrowd_secret
POSTGRES_DB=greencrowd

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL="redis://:redis_secret@localhost:6379"
REDIS_PASSWORD=redis_secret

# ── Keycloak ─────────────────────────────────────────────────
KEYCLOAK_ISSUER=http://localhost:8080/realms/greencrowd
KEYCLOAK_CLIENT_ID=greencrowd-web
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_WEB_SECRET
KEYCLOAK_ALLOWED_AUDIENCES=greencrowd-web,greencrowd-mobile
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_secret
KEYCLOAK_HOSTNAME=localhost
KEYCLOAK_PORT=8080

# ── NextAuth v5 ───────────────────────────────────────────────
AUTH_SECRET=CHANGE_ME_AUTH_SECRET_32_CHARS_MIN
AUTH_URL=http://localhost:3000
# AUTH_TRUST_HOST=true  # enable in production behind a proxy

# ── MinIO (Object Storage) ────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=greencrowd_minio
MINIO_SECRET_KEY=minio_secret_key
MINIO_BUCKET=greencrowd-attachments
MINIO_REGION=us-east-1
MINIO_ROOT_USER=greencrowd_minio
MINIO_ROOT_PASSWORD=minio_secret_key

# ── GAME Engine ───────────────────────────────────────────────
# Outside Docker (local npm run dev): use the mapped port 8001
# Inside Docker: docker-compose overrides this to http://game:8000/api/v1
API_GAME_BASE_URL=http://localhost:8001/api/v1
API_GAME_APIKEY=your_game_api_key_here
NEXT_PUBLIC_API_GAME_BASE_URL=http://localhost:8001/api/v1

# ── GAME Engine — dedicated database ──────────────────────────
GAME_DB_NAME=game_db
GAME_DB_USER=game_user
GAME_DB_PASSWORD=game_secret
GAME_SECRET_KEY=change_this_secret_in_production

# ── Push Notifications (WebPush / VAPID) ──────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@greencrowd.app
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── Push Notifications (FCM v1 — Android/iOS via Firebase Admin) ────────────
# Paste the full JSON content of your Firebase service account key (one line).
# Download from Firebase console → Project Settings → Service Accounts.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Email (SMTP) ───────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GreenCrowd <noreply@greencrowd.app>"

# ── Maps ──────────────────────────────────────────────────────
# Leaflet/OSM by default (no key required)
# Enable Google Maps (only if superadmin activates it):
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Sentry (Error tracking) ───────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Feature Flags ─────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_GOOGLE_MAPS=false
NEXT_PUBLIC_ENABLE_SUPERSET=false
